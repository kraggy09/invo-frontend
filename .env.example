# ==========================================
# InvoSync Frontend Environment Variables Template
# Copy this file to .env and adjust as needed
# ==========================================

# Backend REST API Base URL (e.g. http://localhost:3000/api/v1 or https://api.yourdomain.com/api/v1)
VITE_API_URL=http://localhost:3000/api/v1

# Backend Socket.IO Server URL (e.g. http://localhost:3000 or https://api.yourdomain.com)
VITE_SOCKET_URL=http://localhost:3000